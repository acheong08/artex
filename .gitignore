/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# JWT signing key (generated at runtime in the project root; never commit)
/jwt.key

# Local environment generated for Docker deployment (contains passwords/secrets; do not commit)
.env

# Event logs generated by scheduler runs/simulations (test artifacts; do not commit)
*-events.csv

# Benchmarks (local artifacts; do not commit)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2